# 腾讯混元 API Key（在腾讯云控制台 / TokenHub 创建）
HUNYUAN_API_KEY=sk-在这里填入你的APIKey

# 可选：接口地址与模型 ID，一般不用改
# 注意：混元已迁移至 TokenHub，老接口 api.hunyuan.cloud.tencent.com/v1 不认新 Key
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 模型 ID 从 https://tokenhub.tencentmaas.com/v1/models 查当前可用值
HUNYUAN_MODEL=hy4-flash

# 可选：部署到腾讯云 CloudBase 后，填云函数 generateCards 的 HTTP 访问地址。
# 本地开发留空即可（走 Vite 中间件 /api/generate-cards）。这是公开 URL，不是密钥。
# VITE_AI_API_URL=https://your-env.service.tcloudbase.com/generate-cards
